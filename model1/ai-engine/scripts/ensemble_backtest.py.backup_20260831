    # Rank 12
    "return_1d_rank",
    "return_5d_rank",
    "return_20d_rank",
    "return_60d_rank",
    "close_sma5_ratio_rank",
    "close_sma20_ratio_rank",
    "close_sma50_ratio_rank",
    "close_sma200_ratio_rank",
    "rsi_14_rank",
    "volatility_20d_rank",
