    "/workspace/data/models/tcn_5d.pt"
)

GNN_PATH = Path(
    "/workspace/data/models/gnn_5d.pt"
)

GRAPH_PATH = Path(
    "/workspace/data/features/stock_graph.npz"
)


# =====================================================================
# BASIC FEATURES
# =====================================================================

