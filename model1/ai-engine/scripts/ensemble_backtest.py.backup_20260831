    "volatility_20d",
    "volatility_60d",
    "high_low_range",
    "open_close_return",
    "volume_change",
    "volume_zscore",
]


RANK_FEATURES = [
    "return_1d",
    "return_5d",
    "return_20d",
    "return_60d",
    "close_sma5_ratio",
    "close_sma20_ratio",
    "close_sma50_ratio",
    "close_sma200_ratio",
    "rsi_14",
    "volatility_20d",
    "volatility_60d",
    "volume_zscore",
]


# =====================================================================
# LIGHTGBM FEATURE LIST
#
# This MUST match the trained LightGBM checkpoint.
# Verified from the checkpoint:
# 55 features.
# =====================================================================

